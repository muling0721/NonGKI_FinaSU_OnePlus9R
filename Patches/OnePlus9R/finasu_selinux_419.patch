+/* The 4.19 security server is static. Only replace its policy database,
+ * retaining the SID table, class mapping, status page and native locks.
+ */
+static int install_policy(struct selinux_ss *live, struct selinux_ss *replacement, bool initial)
+{
+    struct policy_file measure = { .len = SIZE_MAX };
+    u32 old_generation = live->latest_granting;
+    u32 generation = old_generation + 1;
+    int ret;
+
+    lockdep_assert_held(&ksu_policy_mutex);
+    ret = policydb_write(&replacement->policydb, &measure);
+    if (ret)
+        return ret;
+    replacement->policydb.len = SIZE_MAX - measure.len;
+
+    write_lock_irq(&live->policy_rwlock);
+    swap(live->policydb, replacement->policydb);
+    live->latest_granting = generation;
+#if !defined(CONFIG_KSU_SUSFS) || !defined(KSU_SUSFS_HAS_TYPE_REGISTRATION)
+    if (initial)
+        ksu_set_original_types(&live->policydb, &replacement->policydb, generation);
+    else
+        ksu_advance_original_types(&live->policydb, &live->policydb, old_generation, generation);
+#endif
+    write_unlock_irq(&live->policy_rwlock);
+    ksu_destroy_sepolicy(replacement);
+
+    reset_avc_cache(generation);
+#ifdef CONFIG_KSU_SUSFS
+    susfs_set_batch_sid();
+#endif
+    return 0;
+}
